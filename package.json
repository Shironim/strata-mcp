{
  "name": "@shironim/strata-mcp",
  "version": "0.4.0",
  "description": "Multi-framework frontend structural AST search, component graph, and route topology engine for AI agents (Vue, React, Next, Nuxt, Astro)",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/types.ts",
  "bin": {
    "strata": "dist/cli.js",
    "strata-mcp": "dist/mcp.js",
    "vue-ast": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/types.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build ./src/cli.ts ./src/mcp.ts ./src/index.ts --outdir ./dist --target bun --external @vue/compiler-sfc --external @vue/compiler-dom --external @ast-grep/cli --external @modelcontextprotocol/sdk",
    "prepublishOnly": "bun run build && bun test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shironim/strata-mcp.git"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vue",
    "astro",
    "react",
    "ast",
    "ast-grep",
    "code-search",
    "sfc",
    "component-tree",
    "blast-radius",
    "route-scanner",
    "sqlite-graph"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ast-grep/cli": "^0.38.0",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/compiler-sfc": "^3.5.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
